{
  "name": "game",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "1.0.6",
    "classnames": "2.5.1",
    "react": "19.3.1",
    "react-countdown": "2.3.6",
    "react-dom": "19.3.1"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check src tests *.ts *.json *.md",
    "fix": "prettier --write src tests *.ts *.json *.md",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:timezones && npm run build && npm run test:e2e",
    "test:timezones": "node scripts/test-timezones.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
